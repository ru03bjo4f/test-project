# 資料庫連線 — 程式會依開頭自動選擇:
#   postgres://...  → PostgreSQL (正式/容器環境; docker compose 預設使用)
#   file:...        → SQLite     (本機快速開發, 免外部資料庫)
#
# 用 docker compose 時資料庫已由 compose 注入, 此處可留 SQLite 供非容器開發:
DATABASE_URL=file:./app.db
# 正式/容器 Postgres 範例:
# DATABASE_URL=postgres://payload:payload@localhost:5432/payload

# Payload 加密金鑰 — 正式環境請改用安全的隨機字串 (例如 openssl rand -hex 32),
# 切勿外洩或提交到 git。
PAYLOAD_SECRET=change-me-to-a-random-secret
